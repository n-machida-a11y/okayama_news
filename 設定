Sub CreateSummaryReport_Append()

    '=================================================================
    ' 【追記＋更新形式】既存キー(日付|事業所)は最新値で上書き、新しいキーは末尾に追加
    '  ※特殊なスペース(NBSP)や制御文字も根こそぎ除去して取りこぼしを防ぐ
    '=================================================================

    ' --- ① 初期設定 ---
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual

    ' --- ② 変数定義 ---
    Dim wsSource As Worksheet, wsDest As Worksheet
    Dim sourceLastRow As Long, destLastRow As Long
    Dim i As Long
    Dim dict As Object, existingDict As Object
    Dim key As Variant

    ' トップレベルのエラーハンドラ: 想定外のエラーは下のErrorHandlerでまとめて処理
    On Error GoTo ErrorHandler

    ' --- ③ ワークシート設定 ---
    On Error Resume Next
    Set wsSource = ThisWorkbook.Sheets("表形式")
    On Error GoTo ErrorHandler
    If wsSource Is Nothing Then
        Err.Raise vbObjectError + 514, "集計マクロ", "「表形式」シートが見つかりません。"
    End If

    On Error Resume Next
    Set wsDest = ThisWorkbook.Sheets("集計")
    On Error GoTo ErrorHandler
    If wsDest Is Nothing Then
        Set wsDest = ThisWorkbook.Sheets.Add(After:=wsSource)
        wsDest.Name = "集計"
    End If

    '----------------------------------------------------------------------
    ' 既存データを読み込み、チェック用のリストを作成
    '----------------------------------------------------------------------
    Set existingDict = CreateObject("Scripting.Dictionary")
    destLastRow = wsDest.Cells(wsDest.Rows.Count, "A").End(xlUp).Row

    If destLastRow > 1 Then 'ヘッダー以外にデータがある場合
        For i = 2 To destLastRow
            Dim existingKey As String
            existingKey = wsDest.Cells(i, "A").Value & "|" & wsDest.Cells(i, "B").Value
            If Not existingDict.Exists(existingKey) Then
                ' 値に行番号を保存することで、後で既存行の上書き先を特定する
                existingDict.Add existingKey, i
            End If
        Next i
    End If

    ' --- ④ 「表形式」シートのデータを読み込み、グループ化 ---
    Set dict = CreateObject("Scripting.Dictionary")
    sourceLastRow = wsSource.Cells(wsSource.Rows.Count, "A").End(xlUp).Row

    ' ヘッダーの列番号を事前に取得
    Dim dateCol As Long, officeCol As Long, itemCol As Long, valueCol As Long, budgetRatioCol As Long, yearRatioCol As Long
    
    On Error Resume Next
    dateCol = Application.Match("日付", wsSource.Rows(1), 0)
    officeCol = Application.Match("事業所", wsSource.Rows(1), 0)
    itemCol = Application.Match("科 目 名", wsSource.Rows(1), 0)
    valueCol = Application.Match("実績額", wsSource.Rows(1), 0)
    budgetRatioCol = Application.Match("予算比", wsSource.Rows(1), 0)
    yearRatioCol = Application.Match("前年比", wsSource.Rows(1), 0)
    On Error GoTo ErrorHandler

    If dateCol = 0 Or officeCol = 0 Or itemCol = 0 Or valueCol = 0 Or budgetRatioCol = 0 Or yearRatioCol = 0 Then
        Err.Raise vbObjectError + 515, "集計マクロ", _
            "「表形式」シートのヘッダー（日付, 事業所, 科 目 名, 実績額, 予算比, 前年比）が見つかりません。"
    End If

    For i = 2 To sourceLastRow
        Dim groupKey As String
        groupKey = wsSource.Cells(i, dateCol).Value & "|" & wsSource.Cells(i, officeCol).Value
        
        If Not dict.Exists(groupKey) Then
            Set dict(groupKey) = CreateObject("Scripting.Dictionary")
        End If

        Dim itemName As String
        itemName = wsSource.Cells(i, itemCol).Value
        
        '----------------------------------------------------------------------
        ' ▼▼▼【修正点・最強版】▼▼▼
        ' 通常のスペースに加え、NBSP（No-Break Space, Chr(160)）や
        ' タブ文字なども削除して、判定を完璧にする
        '----------------------------------------------------------------------
        itemName = Replace(itemName, " ", "")       ' 半角スペース
        itemName = Replace(itemName, "　", "")      ' 全角スペース
        itemName = Replace(itemName, Chr(160), "")  ' NBSP（Web等で使われる特殊スペース）
        itemName = Replace(itemName, vbTab, "")     ' タブ文字
        itemName = Replace(itemName, vbCr, "")      ' 改行コード
        itemName = Replace(itemName, vbLf, "")      ' 改行コード
        
        Select Case itemName
            Case "当期活動増減差額"
                dict(groupKey)("増減差額（円）") = wsSource.Cells(i, valueCol).Value
                dict(groupKey)("予算比差額") = wsSource.Cells(i, budgetRatioCol).Value
                dict(groupKey)("前年比差額") = wsSource.Cells(i, yearRatioCol).Value
            Case "収益計"
                dict(groupKey)("予算比収益") = wsSource.Cells(i, budgetRatioCol).Value
                dict(groupKey)("前年比収益") = wsSource.Cells(i, yearRatioCol).Value
            Case "費用計"
                dict(groupKey)("予算比費用") = wsSource.Cells(i, budgetRatioCol).Value
                dict(groupKey)("前年比費用") = wsSource.Cells(i, yearRatioCol).Value
        End Select
    Next i

    ' --- ⑤ 集計シートへの書き出し ---
    If destLastRow = 0 Or wsDest.Cells(1, 1).Value = "" Then
        Dim headers As Variant
        headers = Array("日付", "事業所", "増減差額（円）", "予算比収益", "予算比費用", "予算比差額", "前年比収益", "前年比費用", "前年比差額")
        wsDest.Range("A1").Resize(1, UBound(headers) + 1).Value = headers
        destLastRow = 1
    End If
    
    Dim addedDataCount As Long, updatedDataCount As Long
    addedDataCount = 0
    updatedDataCount = 0

    Dim writeRow As Long
    For Each key In dict.Keys
        If existingDict.Exists(key) Then
            ' 既存行を上書き更新（同じ日付×事業所のデータが修正された場合に対応）
            writeRow = existingDict(key)
            updatedDataCount = updatedDataCount + 1
        Else
            ' 新規データは末尾に追加
            destLastRow = destLastRow + 1
            writeRow = destLastRow
            addedDataCount = addedDataCount + 1
        End If
        wsDest.Cells(writeRow, "A").Value = Split(key, "|")(0)
        wsDest.Cells(writeRow, "B").Value = Split(key, "|")(1)
        wsDest.Cells(writeRow, "C").Value = dict(key)("増減差額（円）")
        wsDest.Cells(writeRow, "D").Value = dict(key)("予算比収益")
        wsDest.Cells(writeRow, "E").Value = dict(key)("予算比費用")
        wsDest.Cells(writeRow, "F").Value = dict(key)("予算比差額")
        wsDest.Cells(writeRow, "G").Value = dict(key)("前年比収益")
        wsDest.Cells(writeRow, "H").Value = dict(key)("前年比費用")
        wsDest.Cells(writeRow, "I").Value = dict(key)("前年比差額")
    Next key

    ' --- ⑥ 終了処理 ---
    wsDest.Columns.AutoFit
    wsDest.Select
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Exit Sub

' --- エラー処理 ---
ErrorHandler:
    Dim errNum As Long, errDesc As String
    errNum = Err.Number
    errDesc = Err.Description
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    MsgBox "「集計」マクロでエラーが発生しました。" & vbCrLf & _
           "エラー番号: " & errNum & vbCrLf & _
           "内容: " & errDesc, vbCritical, "エラー"
    ' 呼び出し元（実行マクロ）に伝播させ、後続の処理と「完了」表示を抑止する
    Err.Raise errNum, "集計マクロ", errDesc
End Sub
